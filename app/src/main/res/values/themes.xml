<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 公共基类：Material3 DayNight，自动深浅色。 -->
    <style name="Base.Theme.DeviceInfo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <!-- 预设 1：Cyber Blue（默认） -->
    <style name="Theme.DeviceInfo.CyberBlue" parent="Base.Theme.DeviceInfo">
        <item name="colorPrimary">@color/cyber_primary</item>
        <item name="colorSecondary">@color/cyber_secondary</item>
        <item name="colorTertiary">@color/cyber_tertiary</item>
    </style>

    <!-- 预设 2：Neon Green -->
    <style name="Theme.DeviceInfo.NeonGreen" parent="Base.Theme.DeviceInfo">
        <item name="colorPrimary">@color/neon_primary</item>
        <item name="colorSecondary">@color/neon_secondary</item>
        <item name="colorTertiary">@color/neon_tertiary</item>
    </style>

    <!-- 预设 3：Sakura Pink -->
    <style name="Theme.DeviceInfo.SakuraPink" parent="Base.Theme.DeviceInfo">
        <item name="colorPrimary">@color/sakura_primary</item>
        <item name="colorSecondary">@color/sakura_secondary</item>
        <item name="colorTertiary">@color/sakura_tertiary</item>
    </style>

    <!-- 预设 4：Sunset Orange -->
    <style name="Theme.DeviceInfo.SunsetOrange" parent="Base.Theme.DeviceInfo">
        <item name="colorPrimary">@color/sunset_primary</item>
        <item name="colorSecondary">@color/sunset_secondary</item>
        <item name="colorTertiary">@color/sunset_tertiary</item>
    </style>

    <!-- 预设 5：Deep Purple -->
    <style name="Theme.DeviceInfo.Grape" parent="Base.Theme.DeviceInfo">
        <item name="colorPrimary">@color/grape_primary</item>
        <item name="colorSecondary">@color/grape_secondary</item>
        <item name="colorTertiary">@color/grape_tertiary</item>
    </style>

    <!-- 预设 6：Graphite -->
    <style name="Theme.DeviceInfo.Graphite" parent="Base.Theme.DeviceInfo">
        <item name="colorPrimary">@color/graphite_primary</item>
        <item name="colorSecondary">@color/graphite_secondary</item>
        <item name="colorTertiary">@color/graphite_tertiary</item>
    </style>

    <!-- 旧引用别名：manifest 默认走 Cyber Blue，运行时由 ThemeManager 覆盖。 -->
    <style name="Theme.Adr_device_info" parent="Theme.DeviceInfo.CyberBlue" />
</resources>
